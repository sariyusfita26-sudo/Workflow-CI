name: heart-disease-classification

conda_env: conda.yaml

entry_points:
  main:
    parameters:
      train_path:
        type: str
        default: "heart_preprocessing/heart_train.csv"
      test_path:
        type: str
        default: "heart_preprocessing/heart_test.csv"
      n_estimators:
        type: int
        default: 100
      max_depth:
        type: int
        default: 10
      random_state:
        type: int
        default: 42
    command: "python modelling.py --train_path {train_path} --test_path {test_path} --n_estimators {n_estimators} --max_depth {max_depth} --random_state {random_state}"
